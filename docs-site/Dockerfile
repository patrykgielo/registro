FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        entr \
        make \
        findutils \
        tar \
        gzip \
    && rm -rf /var/lib/apt/lists/*

# Official D2 (Terrastruct) installer — https://d2lang.com / github.com/terrastruct/d2
RUN curl -fsSL https://d2lang.com/install.sh | sh -s --

ENV PATH="/root/.local/bin:${PATH}"

# mkdocs-material>=9.7.0 added a JS "stay on page" language-switcher feature
# that intercepts hreflang link clicks and rewrites the target URL client-
# side using sitemap.xml. That rewrite drops the port on non-standard
# host:port setups like ours (Tailscale IP:8090) — confirmed via live click
# testing, landing on the same host but default port 80/443. Pinning below
# 9.7.0 removes that JS layer entirely; the plain <a href> generated by
# mkdocs-static-i18n (already verified correct) is used instead.
RUN pip install --no-cache-dir "mkdocs-material<9.7.0" mkdocs-panzoom-plugin mkdocs-static-i18n==1.3.1

# mkdocs-panzoom-plugin's on_config() does destructive dict.pop("key") (no
# default) on its own self.config. mkdocs-static-i18n rebuilds once per
# language reusing the same plugin instances, so on_config fires again on an
# already-popped dict -> KeyError on the 2nd+ language pass. Patch pop() to be
# idempotent (own upstream TODO acknowledges the re-invocation, no fix yet).
RUN python3 -c "\
import mkdocs_panzoom_plugin.plugin as m, re, inspect; \
path = m.__file__; \
src = open(path).read(); \
patched = re.sub(r'local_config\.pop\((\"[a-z_]+\")\)', r'local_config.pop(\1, None)', src); \
assert patched.count('.pop(') == src.count('.pop(') and 'pop(\"mermaid\", None)' in patched; \
open(path, 'w').write(patched)"

WORKDIR /workspace/docs-site

# Baked-in copy as a fallback; docker-compose.docs.yml bind-mounts over this
# at runtime so live edits are picked up without a rebuild.
COPY . /workspace/docs-site
RUN chmod +x build.sh watch.sh

CMD ["/workspace/docs-site/watch.sh"]
