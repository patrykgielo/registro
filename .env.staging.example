# Staging Environment Configuration
# Copy this file to .env.staging on the staging server (45.93.138.193)
# This file is committed to repo as example only

# ======================
# Application Settings
# ======================
APP_NAME="Registro Staging"
APP_ENV=staging
APP_KEY=  # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://srv1203357.hstgr.cloud
# Base domain ResolveTenant derives tenant subdomains from. Unset it and the
# app falls back to registro.local (config/app.php), resolves no tenant, and
# redirects every visitor off-host. Must match the host this env answers on.
APP_DOMAIN=srv1203357.hstgr.cloud

# Stack-per-tenant only (see app/docs/features/tenant-stack-provisioning.md) --
# this shared staging stack hosts many organizations and must leave these
# unset. See .env.production.example for the full explanation of each.
# TENANT_SLUG: a single organization slug (NOT comma-separated).
# TENANT_SLUG=
# TENANT_HOSTS: comma-separated list of hostnames, no scheme/port. Only
# consulted when TENANT_SLUG (above) is set; empty/unset fails closed (404).
# TENANT_HOSTS=

# CIDR of the reverse proxy/load balancer this app sits behind (config/trustedproxy.php).
# No edge network exists here yet -- leave unset. See .env.production.example.
# TRUSTED_PROXIES_CIDR=

APP_TIMEZONE=Europe/Warsaw

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=10

# ======================
# Logging
# ======================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ======================
# Database (MySQL)
# ======================
DB_CONNECTION=mysql
DB_HOST=mysql  # Docker service name
DB_PORT=3306
DB_DATABASE=registro_staging
DB_USERNAME=registro
DB_PASSWORD=  # CHANGE THIS - Generate with: openssl rand -base64 32

# ======================
# Session & Cache (Redis)
# ======================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.srv1203357.hstgr.cloud
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=staging_cache

# ======================
# Queue (Redis + Horizon)
# ======================
QUEUE_CONNECTION=redis

# ======================
# Redis Configuration
# ======================
REDIS_CLIENT=phpredis
REDIS_HOST=redis  # Docker service name
REDIS_PASSWORD=  # CHANGE THIS - Generate with: openssl rand -base64 32
REDIS_PORT=6379
REDIS_QUEUE=default

# ======================
# Mail Configuration
# ======================
# Staging uses Mailpit for email testing (no real emails sent)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="staging@registro.local"
MAIL_FROM_NAME="${APP_NAME}"

# ======================
# File Storage
# ======================
# CRITICAL: Must be 'public' for file uploads to work
FILESYSTEM_DISK=public

# ======================
# Google Maps API
# ======================
GOOGLE_MAPS_API_KEY=  # Use separate staging key if possible
GOOGLE_MAPS_MAP_ID=AIzaSyBUdTmjpxzTi6WgIJ4ZFhRk2sPtXCrzXwQ

# ======================
# Google Tag Manager (GTM)
# ======================
# Managed via Admin Panel: System Settings → Integrations
# Suggest using different GTM container for staging (GTM-STAGING)

# ======================
# Booking System
# ======================
BOOKING_BUSINESS_HOURS_START=09:00
BOOKING_BUSINESS_HOURS_END=18:00
BOOKING_ADVANCE_HOURS=24
BOOKING_CANCELLATION_HOURS=24
BOOKING_TIMEZONE=Europe/Warsaw
BOOKING_SLOT_INTERVAL=15
BOOKING_MAX_DURATION=540

# ======================
# SMS API (SMSAPI.PL)
# ======================
# Use test mode in staging to avoid sending real SMS
SMSAPI_TOKEN=  # Use same token but enable test mode
SMSAPI_SERVICE=pl
SMSAPI_WEBHOOK_SECRET=  # Generate with: openssl rand -hex 32
SMSAPI_TEST_MODE=true  # IMPORTANT: Prevents real SMS sends

SMS_DAILY_LIMIT=50
SMS_MONTHLY_LIMIT=500
SMS_ALERT_THRESHOLD=80
SMS_ALERT_EMAIL=dev@registro.local

# ======================
# Vite (Frontend Build)
# ======================
VITE_APP_NAME="${APP_NAME}"
VITE_STAGING_BANNER=true  # Show "Staging" banner in UI

# ======================
# AWS (Not used but required)
# ======================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ======================
# Broadcast (Not actively used)
# ======================
BROADCAST_CONNECTION=log
