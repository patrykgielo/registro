# Content creation (local only, never committed)
/content/

# Local Docker development files (not committed)
/mysql/
/php/
/old_config/
*.tar.xz

# ============================================================================
# Docker SSL Certificates (Self-signed - Development Only)
# ============================================================================
docker/ssl/*.pem
docker/ssl/*.key
docker/ssl/*.crt
docker/ssl/*.csr

# ============================================================================
# Database Backups (Never commit to Git)
# ============================================================================
backups/
*.sql
*.sql.gz
.backups/
cookies.txt
app/vendor/

# ============================================================================
# Environment Files - CRITICAL SECURITY
# ============================================================================
# Never commit environment files containing credentials
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example
!.env.local.example
!.env.testing
.env.production
.env.staging
.env.local
.env.backup
.env.old

# ============================================================================
# SSH Keys - CRITICAL SECURITY
# ============================================================================
# Never commit SSH private keys
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
*.ppk
authorized_keys
known_hosts
registro-staging
registro-staging.pub
registro-production
registro-production.pub

# ============================================================================
# Credentials Files - CRITICAL SECURITY
# ============================================================================
# Never commit any files containing passwords or tokens
credentials.txt
passwords.txt
secrets.txt
secrets.json
secrets.yml
.secrets/
.credentials/
*_credentials.*
*_secrets.*

# ============================================================================
# Local Configuration - NOT FOR GIT
# ============================================================================
# SSH config (use ~/.ssh/config instead)
.ssh/
ssh_config
# Local staging credentials (never commit!)
.staging-credentials.local
*.credentials.local
.claude/worktrees/
# cc-doctor: local timestamp for the weekly MCP health check
.claude/.cc-doctor-mcp-stamp
/check_loader.php

# Pest browser test screenshots (local debugging artifacts)
tests/Browser/Screenshots

# ============================================================================
# Architecture docs portal (docker-compose.docs.yml) — build artifacts
# ============================================================================
# .d2 sources are tracked; their compiled .svg output is regenerated by
# docs-site/build.sh on every run (as root, inside the container).
docs/architecture/diagrams/*.svg
app/docs/architecture/diagrams/*.svg
docs-site/site/

# ============================================================================
# Generated Nginx TLS config — server-local, never committed
# ============================================================================
# app.prod-tls.conf is a tracked TEMPLATE carrying a CERT_DOMAIN placeholder.
# deploy-init.sh (and deploy.sh on every release) renders it into the file below
# with the real certificate domain. It must stay untracked: scripts/server/
# deploy.sh runs `git checkout --force` on each deploy, which would revert a
# tracked file back to the placeholder and stop nginx from starting.
docker/nginx/production/app.prod-tls.local.conf
# The renderer writes here first and moves it into place; a failure between the
# two would otherwise leave permanent untracked junk in the working tree.
docker/nginx/production/app.prod-tls.local.conf.tmp

# Same reasoning, edge stack (docker-compose.edge.yml): edge-tls.conf is the
# tracked CERT_DOMAIN template, edge-tls.local.conf is server-local.
docker/nginx/edge/edge-tls.local.conf
docker/nginx/edge/edge-tls.local.conf.tmp

# Per-tenant vhosts name live customer subdomains -- generated at attach time
# (app/docs/deployment/edge-stack.md), never committed. The template stays
# tracked because it doesn't match *.conf (it ends in .disabled).
docker/nginx/edge/tenants.d/*.conf

# Per-tenant service pages are seeded from tenant-pages/_default/ at attach
# time and may be customised per client afterwards -- server-local, not
# tracked. _default/ itself stays tracked as the seed and the fallback.
docker/nginx/edge/tenant-pages/*/
!docker/nginx/edge/tenant-pages/_default/
