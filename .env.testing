APP_NAME=Registro
APP_ENV=testing
APP_KEY=base64:WEy9myRMF4NyFOjycE9sNPIjFJcS1gWbGG1hyTopNCc=
APP_DEBUG=true
APP_URL=https://registro.local:8444
APP_DOMAIN=registro.local
APP_TIMEZONE=Europe/Warsaw

APP_LOCALE=pl
# Not 'pl' -- there is no lang/pl/validation.php (app or vendor) to fall back to,
# so with fallback=pl any validation rule Filament doesn't override with its own
# message (e.g. 'unique') renders the raw "validation.unique" key instead of
# translated text. 'en' at least resolves to Laravel's own framework validation.php.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# CRITICAL: Force SQLite in-memory for tests
# This file REPLACES .env when APP_ENV=testing
# Docker .env has DB_CONNECTION=mysql which overwrites phpunit.xml <env> tags
# .env.testing is the ONLY reliable way to force SQLite in Docker
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
SESSION_SECURE_COOKIE=false
CACHE_STORE=array
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MAIL_MAILER=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
