APP_NAME=Registro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Warsaw
APP_URL=https://srv1342834.hstgr.cloud

# THE most consequential value in this file. ResolveTenant derives every tenant
# subdomain from it (`demo.<APP_DOMAIN>` -> tenant "demo"), and any host that
# does not end in it is redirected to the root domain. Left unset it defaults to
# `registro.local` (config/app.php:68) -- the local development domain -- so the
# server would redirect every real visitor to a hostname that does not exist and
# resolve no tenant at all. Must equal the host this deployment answers on,
# without scheme or port.
APP_DOMAIN=srv1342834.hstgr.cloud

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

# MUST stay 'file'. scripts/server/deploy.sh puts the site into maintenance mode
# around migrations and has to be able to lift it again even when the app
# container is gone -- it does that by deleting storage/framework/{maintenance.php,down}
# straight out of the named volume. A cache-resident flag cannot be cleared that
# way, so the recovery path silently stops working and a failed deploy can leave
# the site 503 with no way back short of the root key.
#
# (The site still enters maintenance under any driver -- the flag file is always
# written. What breaks is getting OUT of it.)
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily', not 'single': a single ever-growing log file fills the disk. This
# matches what docker-compose.prod.yml pins in its environment: blocks.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Which nginx config docker-compose.prod.yml mounts. Start on app.prod.conf --
# it declares no certificates, so nginx can boot on a machine that has none.
#
# The only other valid value is app.prod-tls.local.conf, and deploy-init.sh
# writes it here for you once certbot has issued a real certificate. Never set
# app.prod-tls.conf: that file is a git-tracked TEMPLATE containing a
# CERT_DOMAIN placeholder, and nginx will not start on it. Reverting to plain
# HTTP is this line back to app.prod.conf plus `up -d nginx`.
NGINX_CONF=app.prod.conf

# How port 443 is published. Leave these ALONE until TLS actually works --
# deploy-init.sh sets them to the public addresses in the same step that switches
# NGINX_CONF to the TLS config, so the two never diverge.
#
# The defaults bind 443 to loopback, which means an outside connection is REFUSED
# immediately. That is deliberate and it matters: nginx listens on 443 only under
# the TLS config, so publishing the port on 0.0.0.0 beforehand makes docker-proxy
# ACCEPT the connection and then hang, with nothing behind it. Browsers try HTTPS
# first for a typed domain, hit that, and report ERR_CONNECTION_TIMED_OUT -- the
# site looks completely dead while port 80 is serving it perfectly. A refused
# connection instead makes the browser fall back to HTTP in milliseconds.
#
# With TLS on:  HTTPS_PORT_V4=0.0.0.0:443:443   HTTPS_PORT_V6=[::]:443:443
HTTPS_PORT_V4=127.0.0.1:443:443
HTTPS_PORT_V6=[::1]:443:443

# The directory name under /etc/letsencrypt/live/ that certbot actually created.
# Written automatically by deploy-init.sh; leave it blank until then.
#
# It should always equal the bare hostname, because deploy-init.sh passes
# --cert-name to certbot, which pins the lineage and therefore the directory.
# Without that flag certbot appends -0001, -0002 ... whenever the set of names on
# the certificate changes, and since a `www.` name is only requested when it
# resolves, that rename would happen on some later run and point nginx at a stale
# directory. This variable exists so scripts/server/deploy.sh -- which re-renders
# the TLS config after every checkout -- never has to guess.
CERT_DIR=

# Image tag pulled from GHCR by docker-compose.prod.yml (app, horizon, scheduler).
# Rolling back means changing this line and re-running `docker compose up -d`,
# nothing else -- which only works if it names an immutable tag.
#
# 'latest' below is a bootstrap placeholder, valid only until the first release
# is deployed: scripts/server/deploy.sh overwrites it with the real tag on every
# successful deploy. If you are reading this on a server that has deployed at
# least once and it still says 'latest', something is wrong.
REGISTRO_VERSION=latest

DB_CONNECTION=mysql
# The compose SERVICE name, not the container_name. docker-compose.prod.yml
# passes DB_HOST=mysql to the container and that wins over this file, so a
# mismatch here is inert -- but it will send someone down the wrong path while
# debugging a connection failure.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=registro
DB_USERNAME=registro
DB_PASSWORD=
# Used only to initialise the mysql container; not used by the application.
DB_ROOT_PASSWORD=

# NOTE: docker-compose.prod.yml pins SESSION_DRIVER, SESSION_ENCRYPT,
# SESSION_SECURE_COOKIE, SESSION_SAME_SITE, CACHE_STORE and QUEUE_CONNECTION in its
# `environment:` blocks. Container env beats .env, so changing them here alone does
# nothing -- change the compose file too. Values below mirror what actually runs.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leading dot only if tenant subdomains share the session cookie and wildcard
# DNS exists for this host. Leave empty when serving a single hostname.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
# 'public' or 's3' -- never 'local', it breaks uploads.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Must be identical for app, horizon and scheduler -- a mismatch fails silently
# as "queues never run" rather than as an error.
#
# MUST be non-empty. docker-compose.prod.yml passes this straight into
# `redis-server --requirepass ${REDIS_PASSWORD} --maxmemory 256mb`; leave it
# blank and the token vanishes, redis takes "--maxmemory" as the password and
# exits, and cache, sessions and queues go down with it.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@srv1342834.hstgr.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (optional - for cloud file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=registro-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# SMSAPI (optional)
SMSAPI_TOKEN=
SMSAPI_SERVICE=pl
SMSAPI_WEBHOOK_SECRET=

# Przelewy24 -- DEFERRED. The application launches and runs without online
# payments; config/przelewy24.php defaults every value. Fill these in only when
# switching payments on, and set P24_LIVE=true last.
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_REPORTS_KEY=
P24_LIVE=false
# Grace period (minutes) before an order with a registered P24 transaction may be
# cancelled by orders:cleanup-expired -- a slow BLIK/bank confirmation must not be
# cancelled out from under the customer. Read via Order::ttlGraceMinutes(), which
# clamps it to [0, 1440].
P24_TRANSACTION_GRACE_MINUTES=120

# Filament
FILAMENT_FILESYSTEM_DISK=public
