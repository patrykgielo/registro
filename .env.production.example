APP_NAME=Registro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Warsaw
APP_URL=https://srv1342834.hstgr.cloud

# THE most consequential value in this file. ResolveTenant derives every tenant
# subdomain from it (`demo.<APP_DOMAIN>` -> tenant "demo"), and any host that
# does not end in it is redirected to the root domain. Left unset it defaults to
# `registro.local` (config/app.php:68) -- the local development domain -- so the
# server would redirect every real visitor to a hostname that does not exist and
# resolve no tenant at all. Must equal the host this deployment answers on,
# without scheme or port.
APP_DOMAIN=srv1342834.hstgr.cloud

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily', not 'single': a single ever-growing log file fills the disk. This
# matches what docker-compose.prod.yml pins in its environment: blocks.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Which nginx config docker-compose.prod.yml mounts. Start on app.prod.conf --
# it declares no certificates, so nginx can boot on a machine that has none.
#
# The only other valid value is app.prod-tls.local.conf, and deploy-init.sh
# writes it here for you once certbot has issued a real certificate. Never set
# app.prod-tls.conf: that file is a git-tracked TEMPLATE containing a
# CERT_DOMAIN placeholder, and nginx will not start on it. Reverting to plain
# HTTP is this line back to app.prod.conf plus `up -d nginx`.
NGINX_CONF=app.prod.conf

# Image tag pulled from GHCR by docker-compose.prod.yml (app, horizon, scheduler).
# Set it to an immutable tag, never 'latest' -- rolling back means changing this
# line and re-running `docker compose up -d`, nothing else.
REGISTRO_VERSION=latest

DB_CONNECTION=mysql
DB_HOST=registro-mysql
DB_PORT=3306
DB_DATABASE=registro
DB_USERNAME=registro
DB_PASSWORD=
# Used only to initialise the mysql container; not used by the application.
DB_ROOT_PASSWORD=

# NOTE: docker-compose.prod.yml pins SESSION_DRIVER, SESSION_ENCRYPT,
# SESSION_SECURE_COOKIE, SESSION_SAME_SITE, CACHE_STORE and QUEUE_CONNECTION in its
# `environment:` blocks. Container env beats .env, so changing them here alone does
# nothing -- change the compose file too. Values below mirror what actually runs.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leading dot only if tenant subdomains share the session cookie and wildcard
# DNS exists for this host. Leave empty when serving a single hostname.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
# 'public' or 's3' -- never 'local', it breaks uploads.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Must be identical for app, horizon and scheduler -- a mismatch fails silently
# as "queues never run" rather than as an error.
#
# MUST be non-empty. docker-compose.prod.yml passes this straight into
# `redis-server --requirepass ${REDIS_PASSWORD} --maxmemory 256mb`; leave it
# blank and the token vanishes, redis takes "--maxmemory" as the password and
# exits, and cache, sessions and queues go down with it.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@srv1342834.hstgr.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (optional - for cloud file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=registro-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# SMSAPI (optional)
SMSAPI_TOKEN=
SMSAPI_SERVICE=pl
SMSAPI_WEBHOOK_SECRET=

# Przelewy24 -- DEFERRED. The application launches and runs without online
# payments; config/przelewy24.php defaults every value. Fill these in only when
# switching payments on, and set P24_LIVE=true last.
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_REPORTS_KEY=
P24_LIVE=false
# Grace period (minutes) before an order with a registered P24 transaction may be
# cancelled by orders:cleanup-expired -- a slow BLIK/bank confirmation must not be
# cancelled out from under the customer. Read via Order::ttlGraceMinutes(), which
# clamps it to [0, 1440].
P24_TRANSACTION_GRACE_MINUTES=120

# Filament
FILAMENT_FILESYSTEM_DISK=public
